# SQLite file lives next to the Prisma schema (prisma/dev.db).
# Swap to Postgres by changing provider in prisma/schema.prisma
# and setting a postgresql:// URL here.
DATABASE_URL="file:./dev.db"

# Pepper for session token hashes. Use a long random value in production.
AUTH_SECRET="replace-with-a-long-random-string"

# Seed owner. Re-run `npm run seed` after changing these (seed resets demo data).
OWNER_EMAIL="bart@atelier.local"
OWNER_PASSWORD="bart-atelier"
OWNER_NAME="Bart Matero"
OWNER_HANDLE="bart"

# Shared password for the seeded member accounts (alex, sam, jordan).
MEMBER_PASSWORD="member-atelier"
